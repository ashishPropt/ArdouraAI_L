generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  githubToken    String?
  githubUsername String?
  vultrApiKey    String?

  projects      Project[]
  accounts      Account[]
  sessions      Session[]
  integrations  Integration[]
  tokenBudgets  TokenBudget[]
  cloudInstances CloudInstance[]
  rules         Rule[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// BUILDER (existing)
// ─────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  githubRepo      String?
  githubOwner     String?
  deployedUrl     String?
  vultrInstanceId String?
  vultrIp         String?
  status          ProjectStatus @default(ACTIVE)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
  files        ProjectFile[]
  healActions  HealAction[]
  incidents    Incident[]
  llmUsageLogs LLMUsageLog[]
  monitors     Monitor[]
  dbConnections DatabaseConnection[]

  @@index([userId])
}

model Message {
  id        String      @id @default(cuid())
  projectId String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())
  metadata  Json?
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String   @db.Text
  language  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, path])
  @@index([projectId])
}

// ─────────────────────────────────────────────
// MCP INTEGRATIONS + CREDENTIAL VAULT
// ─────────────────────────────────────────────

model Integration {
  id          String          @id @default(cuid())
  userId      String
  type        IntegrationType
  name        String          // display label e.g. "Prod Jira"
  config      String          @db.Text // AES-256 encrypted JSON
  active      Boolean         @default(true)
  lastTestedAt DateTime?
  lastTestOk  Boolean?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type])
}

// ─────────────────────────────────────────────
// KAFKA EVENT LOG
// ─────────────────────────────────────────────

model KafkaEvent {
  id          String   @id @default(cuid())
  topic       String
  key         String?
  payload     Json
  source      String
  processed   Boolean  @default(false)
  processingResult Json?
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([topic, processed])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// RULE ENGINE
// ─────────────────────────────────────────────

model Rule {
  id          String     @id @default(cuid())
  userId      String
  projectId   String?    // target project this rule applies to
  name        String
  description String?
  topic       String     // kafka topic to match
  conditions  Json       // array of { field, operator, value }
  actions     Json       // array of { tool, action, params }
  priority    Int        @default(100)
  enabled     Boolean    @default(true)
  cooldownMs  Int?       // minimum ms between firings
  fireCount   Int        @default(0)
  lastFiredAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, topic, enabled])
  @@index([projectId, topic, enabled])
}

// ─────────────────────────────────────────────
// SELF-HEALING / HITL
// ─────────────────────────────────────────────

model HealAction {
  id           String       @id @default(cuid())
  projectId    String?
  incidentId   String?      // FK to Incident
  incidentRef  String?      // ServiceNow/Jira external ID
  title        String
  description  String       @db.Text
  proposedFix  String       @db.Text
  fixType      String       // OOM | CRASH | DISK | CODE_PATCH | SCALE_UP | CUSTOM
  diff         String?      @db.Text
  riskLevel    RiskLevel    @default(MEDIUM)
  status       ActionStatus @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  rejectedBy   String?
  rejectionNote String?
  appliedAt    DateTime?
  verifiedAt   DateTime?
  evidence     Json?        // logs, metrics, stack traces that led to this
  result       Json?        // execution result
  createdAt    DateTime     @default(now())

  project  Project?  @relation(fields: [projectId], references: [id])
  incident Incident? @relation(fields: [incidentId], references: [id])
  @@index([status])
  @@index([projectId])
  @@index([incidentId])
}

// ─────────────────────────────────────────────
// TOKEN / LLM USAGE
// ─────────────────────────────────────────────

model LLMUsageLog {
  id           String   @id @default(cuid())
  userId       String
  projectId    String?
  provider     String   @default("anthropic")
  model        String
  feature      String   @default("chat")  // CODEGEN | CHAT | ANALYSIS | HEALING | EXPLANATION
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  durationMs   Int?
  createdAt    DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id])
  @@index([userId, createdAt])
  @@index([model, createdAt])
}

model TokenBudget {
  id         String      @id @default(cuid())
  userId     String
  name       String
  limitUsd   Float
  currentUsd Float       @default(0)
  model      String?     // if set, tracks only this model
  action     BudgetAction @default(ALERT)
  alertPct   Float       @default(80)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ─────────────────────────────────────────────
// CLOUD MANAGER
// ─────────────────────────────────────────────

model CloudInstance {
  id           String   @id @default(cuid())
  userId       String
  projectId    String?
  provider     String   @default("vultr")
  providerId   String   @unique
  label        String
  ip           String?
  region       String
  plan         String
  os           String?
  status       String
  monthlyCost  Float
  sshKeyId     String?
  tags         String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics InstanceMetric[]
  @@index([userId])
}

model InstanceMetric {
  id         String   @id @default(cuid())
  instanceId String
  cpuPct     Float?
  ramPct     Float?
  diskPct    Float?
  bandwidthMb Float?
  timestamp  DateTime @default(now())

  instance CloudInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  @@index([instanceId, timestamp])
}

// ─────────────────────────────────────────────
// SRE MONITORING
// ─────────────────────────────────────────────

model Monitor {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  url           String
  intervalSecs  Int      @default(60)
  timeoutSecs   Int      @default(10)
  method        String   @default("GET")
  expectedStatus Int     @default(200)
  active        Boolean  @default(true)
  lastStatus    String?  // UP | DOWN | DEGRADED
  lastCheckedAt DateTime?
  createdAt     DateTime @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks    MonitorCheck[]
  incidents Incident[]
  @@index([projectId, active])
}

model MonitorCheck {
  id          String   @id @default(cuid())
  monitorId   String
  status      String   // UP | DOWN | TIMEOUT
  statusCode  Int?
  responseMs  Int?
  error       String?
  checkedAt   DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  @@index([monitorId, checkedAt])
}

model Incident {
  id           String    @id @default(cuid())
  monitorId    String?
  projectId    String?
  title        String
  severity     String    @default("P2")
  status       String    @default("OPEN") // OPEN | INVESTIGATING | RESOLVED
  source       String    // MONITOR | DATADOG | DYNATRACE | MANUAL
  externalRef  String?   // ServiceNow / Jira ID
  rootCause    String?
  resolution   String?
  startedAt    DateTime  @default(now())
  resolvedAt   DateTime?

  monitor     Monitor?     @relation(fields: [monitorId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])
  healActions HealAction[]
  @@index([status])
  @@index([projectId])
}

// ─────────────────────────────────────────────
// DATABASE CONNECTIONS (for monitored apps)
// ─────────────────────────────────────────────

model DatabaseConnection {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  type        String   // POSTGRES | MYSQL | MONGODB
  config      String   @db.Text // AES-256 encrypted JSON
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ProjectStatus {
  ACTIVE
  DEPLOYED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTING
  APPLIED
  VERIFIED
  FAILED
}

enum BudgetAction {
  ALERT
  DOWNGRADE
  STOP
}

enum IntegrationType {
  GITHUB
  JIRA
  CONFLUENCE
  SERVICENOW
  DATADOG
  DYNATRACE
  KAFKA
  SLACK
  PAGERDUTY
  DATABASE
  VULTR
  EMAIL
}
